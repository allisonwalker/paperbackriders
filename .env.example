# Server only. Do not expose these to the browser.
# Local, preview, and production each use their own Neon branch.
DATABASE_URL=

# Neon host of the production branch, with no user or password.
# Preview and local refuse to connect when DATABASE_URL uses this host.
# The one-time import accepts only this host, and only off Vercel.
# Example: ep-example.c-5.us-west-2.aws.neon.tech
PRODUCTION_DATABASE_HOST=

# Non-production Neon host used for the one confirmed catalog restore.
# No user or password. The import refuses until this is set, and refuses when
# it is the production host. Set it only after that restore's catalog counts match.
# Example: ep-restore.c-5.us-west-2.aws.neon.tech
CATALOG_RESTORE_HOST=

# Signs the session cookie. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Production domain only, for example https://paperbackriders.example.
# Leave unset on preview and local so the request host is used.
BETTER_AUTH_URL=

# The only address that can receive a sign-in link.
RECORD_KEEPER_EMAIL=

# Resend. RESEND_FROM must be a sender on a domain Resend has verified.
RESEND_API_KEY=
RESEND_FROM=

# Club calendar. Settled for v1.
CLUB_TIMEZONE=America/Los_Angeles

# Geoapify forward geocoding. Server only.
GEOAPIFY_API_KEY=

# latitude,longitude near where the club usually meets. Not a secret.
# Place search refuses to run when this is missing or is not two coordinates.
CLUB_PLACE_BIAS=
